---
apiVersion: v1
kind: ConfigMap
metadata:
  name: coredns
  namespace: kube-system
data:
  Corefile: |
    .:53 {
      errors
      log
      health
      kubernetes cluster.local 10.0.0.0/24
      prometheus :9153
      proxy . /etc/resolv.conf
      cache 30
      reload
    }
    consul {
     log
     errors
     cache 30
     forward . $CONSUL_DNS_IP {
      # policy round_robin
      # health_check /health:8080
      }
    }
