
pipeline {
    agent
    {
        label 'Slave'
    }

    environment
    {
        user_name = 'Galit U.'
        project = 'Kandula-MidPrj'
        purpose = 'OpsSchool course'
        git_hub_repo_path = 'git@github.com:GalitU/Mid_project_kandula-app-8_pvt.git'
        kandula_mid_docker_image_name_prefix = 'kandula-mid-prj'
        docker_repo_path = 'galitu/kandula-repo'
        git_hub_credentials = 'jenkins-mid-kandula-git-ssh'
        git_hub_branch_name = 'BranchMidProject'
        dicker_repo_path = 'galitu/kandula-repo'
        git_hub_repo_path_eks = 'git@github.com:GalitU/Mid_project_Kandula_deployment.git'
        git_hub_branch_name_eks = 'main'
    }
    stages
    {
        stage("Git Clone")
        {
            steps
            {
                slackSend color: 'GREEN', message: "GalitU. Start build of new docker version of Kandula  ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
                echo "===>> Git Clone from $git_hub_repo_path"
                git branch: "${git_hub_branch_name}", credentialsId: "${git_hub_credentials}", url: "${git_hub_repo_path}"
                sh "ls -lart ./*"
                sh "git branch -a"
            }
        }
        stage("Docker build and Tag")
        {
            steps
            {
                echo "===>> Docker image ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 will be build"
                sh 'docker version'
                sh 'docker build -t ${kandula_mid_docker_image_name_prefix} .'
                sh 'docker image list'
                sh 'docker tag ${kandula_mid_docker_image_name_prefix} ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0'
            }
        }
        stage("Push docker to private registry")
        {
            environment
            {
                docker_hub_credentials = "docker.hub.credentials"
            }
            steps
            {
                echo "===>> Push docker image ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 to $docker_repo_path"
                withDockerRegistry([ credentialsId: "${docker_hub_credentials}", url: "" ])
                {
                    sh 'docker push ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0'
                }
                slackSend color: 'GREEN', message: "GalitU. New docker image ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER} is ready for deployment"
            }
        }
        stage("Clean docker image from disk of Node")
        {
            steps
            {
                echo "===>> Delete docker image ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 from Node ${env.NODE_NAME}"
                sh 'docker images'
                sh 'docker rmi ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0'
                sh 'docker images'
                sh 'docker rmi ${kandula_mid_docker_image_name_prefix}:latest'
            }
        }
        stage("Get Kandula pod manifests from Git")
        {
            steps
            {
                echo "===>> Git Clone from $git_hub_repo_path"
                git branch: "${git_hub_branch_name_eks}", credentialsId: "${git_hub_credentials}", url: "${git_hub_repo_path_eks}"
                sh "ls -lart ./*"
                sh "git branch -a"
            }
        }
        stage("Update Kandula secrets")
        {
    	    steps
	        {
                sh """
tee ${WORKSPACE}/pod_kandula_secrets.yaml > /dev/null <<'EOF'
apiVersion: v1
kind: Secret
metadata:
  name: kandula-secrets
type: Opaque
data:
  AWS_ACCESS_KEY_ID : QUtJQVhMQTY3QlRaT0NURlhJTjU=
  AWS_SECRET_ACCESS_KEY : d0lqZklteEpTVlZJWXk5NGNDR2twc3FzVHliVWlCbTlleE92Y2o3RQ==
  AWS_DEFAULT_REGION : ZXUtY2VudHJhbC0x
EOF
                """
            }
        }
        stage("Update manifest version number")
        {
            steps
            {
                sh """
tee ${WORKSPACE}/pod-kandula.yaml > /dev/null <<'EOF'
apiVersion: v1
kind: Pod
metadata:
  name: kandula-pod
  labels:
    app: backend
spec:
  containers:
    - image: ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0
      name: kandula
      ports:
        - containerPort: 5000
          name: http
          protocol: TCP
      env:
        - name: FLASK_ENV
          value: development

      envFrom:
        - secretRef:
            name: kandula-secrets
EOF
                """
            }
        }
        stage("Commit and push manifests to Git with new version number")
        {
            steps
            {
                echo "===>> Commit and push to $git_hub_repo_path_eks"
                sshagent(['jenkins-mid-kandula-git-ssh']) {
                    sh 'git add pod-kandula.yaml'
                    sh 'git commit -m "Automatic commit from Jenkins, build version ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0"'
                    sh "git push origin main"
                }
                slackSend color: 'GREEN', message: "GalitU. Kandula pod manifest was commited automatically from Jenkins with new version number ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
                slackSend color: 'GREEN', message: "GalitU. Kandula docker is ready with new version ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
            }
        }
    }
}
