pipeline {
    agent
    {
        label 'Slave'
    }

    environment
    {
        user_name = 'Galit U.'
        project = 'Kandula-FinalPrj'
        purpose = 'OpsSchool course'
        git_hub_repo_path = 'git@github.com:GalitU/Kandula_code.git'
        kandula_final_docker_image_name_prefix = 'kandula-final-prj'
        docker_repo_path = 'galitu/kandula-repo'
        git_hub_credentials = 'jenkins-mid-kandula-git-ssh'
        git_hub_branch_name = 'BranchFinalProject'
        git_hub_repo_path_eks = 'git@github.com:GalitU/Kandula_deployment.git'
        git_hub_branch_name_eks = 'main'
        slack_color_good = "#00FF00"
        slack_color_failure =  "#FF0000"
        end = "success"
        kandula_version = "v4.0.$BUILD_NUMBER"
        kandula_hotfix_version = "v4.0.$BUILD_NUMBER"
    }

    stages
    {
        stage("Git Clone")
        {
            steps
            {
                script
                {
                    try {
                        echo "===>> Git Clone from $git_hub_repo_path"
                        git branch: "${git_hub_branch_name}", credentialsId: "${git_hub_credentials}", url: "${git_hub_repo_path}"
                        sh "ls -lart ./*"
                        sh "git branch -a"
                        env.COMMIT_VERSION = sh(returnStdout: true, script: 'git rev-parse --short=8 HEAD').trim()
                        env.kandula_full_version="${kandula_hotfix_version}.${env.COMMIT_VERSION}"
                        env.kandula_full_path_with_version="${docker_repo_path}:${kandula_final_docker_image_name_prefix}-${kandula_full_version}"
                        sh 'echo "Version of Kandula $kandula_full_version" > ${WORKSPACE}/app/views/version.txt'
                        slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_good, message: ":green_heart: <@U03HH1727NK>. Start build of new docker version of Kandula  ${kandula_full_path_with_version}, Build #${env.BUILD_NUMBER}"
                    } catch (Exception e) {
                        end = "failure"
                        slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_failure, message: ":bangbang: <@U03HH1727NK>: Failed checkout ${git_hub_repo_path}"
                        sh 'might fail'
                    }
                }
            }
        }
        stage("Docker build and Tag")
        {
            steps
            {
                script
                {
                    try
                    {
                        echo "===>> Docker image ${kandula_full_path_with_version} will be build"
                        sh 'docker version'
                        sh 'docker build -t $kandula_full_path_with_version .'
                    } catch (Exception e) {
                        end = "failure"
                        slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_failure, message: ":bangbang: <@U03HH1727NK>: Build docker image failed for  ${kandula_full_path_with_version}, Build #${env.BUILD_NUMBER}"
                        sh 'might fail'
                    }
                }
            }
        }
        stage("Security Scanning of docker image")
        {
            steps
            {
                script
                {
                    try
                    {
                        echo "===>> Docker image ${kandula_full_path_with_version} will be validate for security issiues"
                        sh 'trivy image $kandula_full_path_with_version'
                    } catch (Exception e) {
                        end = "failure"
                        slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_failure, message: ":bangbang: <@U03HH1727NK>: Security Scanning of docker image ${kandula_full_path_with_version} failed, Build #${env.BUILD_NUMBER}"
                        sh 'might fail'
                    }
                }
            }
        }
        stage("Push docker to private registry")
        {
            environment
            {
                docker_hub_credentials = "docker.hub.credentials"
            }
            steps
            {
                script
                {
                    try {
                        echo "===>> Push docker image ${kandula_full_path_with_version} to $docker_repo_path"
                        withDockerRegistry([ credentialsId: "${docker_hub_credentials}", url: "" ])
                        {
                            sh 'docker push $kandula_full_path_with_version'
                        }
                        slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_good, message: ":purple_heart: <@U03HH1727NK>: New docker image ${kandula_full_path_with_version}, Build #${env.BUILD_NUMBER} is ready for deployment"
                    } catch (Exception e) {
                        end = "failure"
                        slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_failure, message: ":bangbang: <@U03HH1727NK>: Failed upload docker image to docker hub for  ${kandula_full_path_with_version} #${env.BUILD_NUMBER}"
                        sh 'might fail'
                    }
                }
            }
        }
        stage("Clean docker image from disk of Node")
        {
            steps
            {
                script
                {
                    try {
                        echo "===>> Delete docker image ${kandula_full_path_with_version} from Node ${env.NODE_NAME}"
                        sh 'docker images'
                        sh 'docker rmi $kandula_full_path_with_version'
                        sh 'docker images'
                    } catch (Exception e) {
                        end = "failure"
                        slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_failure, message: ":bangbang: <@U03HH1727NK>: Failed clean image from Jenkins agent for  ${kandula_full_path_with_version} #${env.BUILD_NUMBER}"
                        sh 'might fail'
                    }
                }
            }
        }
        stage("Get Kandula pod manifests from Git")
        {
            steps
            {
                script
                {
                    try {
                        echo "===>> Git Clone from $git_hub_repo_path"
                        git branch: "${git_hub_branch_name_eks}", credentialsId: "${git_hub_credentials}", url: "${git_hub_repo_path_eks}"
                        sh "ls -lart ./*"
                        sh "git branch -a"
                    } catch (Exception e) {
                        end = "failure"
                        slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_failure, message: ":bangbang: <@U03HH1727NK>: Failed checkout Kandula pod manifest from ${git_hub_repo_path_eks} for ${kandula_full_path_with_version} #${env.BUILD_NUMBER}"
                        sh 'might fail'
                    }
                }
            }
        }
        stage("Update manifest version number")
        {
            steps
            {
                sh """
tee ${WORKSPACE}/kandula_on_kube.yaml > /dev/null <<'EOF'
---
apiVersion: v1
kind: Namespace
metadata:
  name: kandula
  labels:
    task: Final-Project
    app: kandula

---
apiVersion: apps/v1
kind: Deployment
metadata:
  namespace: kandula
  name: deployment-kandula-app
  annotations:
    kubernetes.io/change-cause: "Release Kandula:$kandula_full_version"
    consul.hashicorp.com/connect-inject       : "true"
    consul.hashicorp.com/transparent-proxy    : "false"
    consul.hashicorp.com/connect-service      : "kandula"
    consul.hashicorp.com/connect-service-port : "5000"
    consul.hashicorp.com/service-tags         : "kandula,fprj"
    consul.hashicorp.com/service-name         : "kandula-application"
    consul.hashicorp.com/service-meta-owner   : "Galit Udovik"
    consul.hashicorp.com/service-meta-purpose : "Kandula final project"
    prometheus.io/scrape                      : "true"
    prometheus.io/port                        : "5000"
    prometheus.io/path                        : "/metrics"
  labels:
    version: $kandula_full_version
    task: Final-Project
    app: kandula
spec:
  replicas: 2
  minReadySeconds: 10
  strategy:
    type: RollingUpdate
    rollingUpdate:
        maxUnavailable: 1
        maxSurge: 1
  selector:
    matchLabels:
      app: kandula
  template:
    metadata:
      labels:
        version: $kandula_full_version
        app: kandula
      annotations:
        kubernetes.io/change-cause: "Release Kandula:$kandula_full_version"
        consul.hashicorp.com/connect-inject       : "true"
        consul.hashicorp.com/transparent-proxy    : "false"
        consul.hashicorp.com/connect-service      : "kandula"
        consul.hashicorp.com/connect-service-port : "5000"
        consul.hashicorp.com/service-tags         : "kandula,fprj"
        consul.hashicorp.com/service-name         : "kandula-application"
        consul.hashicorp.com/service-meta-owner   : "Galit Udovik"
        consul.hashicorp.com/service-meta-purpose : "Kandula final project"
        prometheus.io/scrape                      : "true"
        prometheus.io/port                        : "5000"
        prometheus.io/path                        : "/metrics"
    spec:
      containers:
        - name: kandula
          image: $kandula_full_path_with_version
          ports:
            - containerPort: 5000
              name: http
              protocol: TCP
          env:
            - name: FLASK_ENV
              value: development
          envFrom:
            - secretRef:
              name: kandula-secrets

---
apiVersion: v1
kind: Service
metadata:
  namespace: kandula
  name: kandula-cluster-ip
  annotations:
    consul.hashicorp.com/service-name         : "kandula-application"
    consul.hashicorp.com/service-port         : "http"
    consul.hashicorp.com/service-tags         : "kandula,fprj"
    consul.hashicorp.com/service-meta-owner   : ""Galit Udovik""
    consul.hashicorp.com/service-meta-purpose : ""Kandula final project""
    consul.hashicorp.com/connect-inject       : "true"
    consul.hashicorp.com/transparent-proxy    : "false"
    consul.hashicorp.com/connect-service      : "kandula"
    consul.hashicorp.com/connect-service-port : "5000"
    prometheus.io/scrape                      : "true"
    prometheus.io/port                        : "5000"
  labels:
    version: $kandula_full_version
    task: Final-Project
    app: kandula
spec:
  selector:
    app: kandula
  type: ClusterIP
  ports:
    - name: http
      port: 80
      targetPort: 5000

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  namespace: kandula
  name: kandula-ingress
  labels:
    version: $kandula_full_version
    task: Final-Project
    app: kandula
  annotations:
    kubernetes.io/ingress.class: "alb"
    alb.ingress.kubernetes.io/scheme: "internet-facing"
    alb.ingress.kubernetes.io/target-type: "ip"
    alb.ingress.kubernetes.io/backend-protocol: "HTTP"
    alb.ingress.kubernetes.io/group.name: "kandula"
    alb.ingress.kubernetes.io/healthcheck-path: "/liveness"
    alb.ingress.kubernetes.io/healthcheck-port: "8151"
    alb.ingress.kubernetes.io/healthcheck-protocol: "HTTP"
    alb.ingress.kubernetes.io/listen-ports: "[{"HTTPS":443}]"
    #alb.ingress.kubernetes.io/listen-ports: "'[{"HTTPS":443, "HTTP":80}]"
    alb.ingress.kubernetes.io/actions.ssl-redirect: "{"Type": "redirect", "RedirectConfig": { "Protocol": "HTTPS", "Port": "443", "StatusCode": "HTTP_301"}}"
    #alb.ingress.kubernetes.io/certificate-arn: <cert>
    alb.ingress.kubernetes.io/tags: "Owner=Galit Udovik,Task=Kandula,App_name=FPrj,CreatedBy=IngressYaml"
    alb.ingress.kubernetes.io/load-balancer-attributes: "idle_timeout.timeout_seconds=4000,routing.http2.enabled=false"
    alb.ingress.kubernetes.io/target-group-attributes: "stickiness.enabled=true,stickiness.lb_cookie.duration_seconds=86400"
    alb.ingress.kubernetes.io/load-balancer-name: "kubernetes-alb"
    external-dns.alpha.kubernetes.io/hostname: "kandula.galitu.site"
    ### kubernetes.io/tls-acme: "true"

spec:
  #ingressClassName: alb
  defaultBackend:
    service:
      name: kandula-cluster-ip
      port:
        number: 80
  rules:
    - host: kandula.galitu.site
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ssl-redirect
                port:
                  name: use-annotation
          - path: /
            pathType: Prefix
            backend:
              service:
                name: kandula-cluster-ip
                port:
                  number: 80

    - host: kandula-metrics.galitu.site
      http:
        paths:
          - path: /metrics
            pathType: Prefix
            backend:
              service:
                name: kandula-cluster-ip
                port:
                  number: 80

    - host: kandula_raw_instances.galitu.site
      http:
        paths:
          - path: /raw-instances
            pathType: Prefix
            backend:
              service:
                name: kandula-cluster-ip
                port:
                  number: 80
EOF
            cat ${WORKSPACE}/kandula_on_kube.yaml
                """

                sh """
tee ${WORKSPACE}/deploy-kandula.yaml > /dev/null <<'EOF'
apiVersion: apps/v1
kind: Deployment
metadata:
  namespace: kandula
  name: deployment-kandula-app
  annotations:
    kubernetes.io/change-cause                : "Release Kandula:$kandula_full_version"
    consul.hashicorp.com/connect-inject       : "true"
    consul.hashicorp.com/transparent-proxy    : "false"
    consul.hashicorp.com/connect-service      : "kandula"
    consul.hashicorp.com/connect-service-port : "5000"
    consul.hashicorp.com/service-tags         : "kandula,fprj"
    consul.hashicorp.com/service-name         : "kandula-application"
    consul.hashicorp.com/service-meta-owner   : "Galit Udovik"
    consul.hashicorp.com/service-meta-purpose : "Kandula final project"
    prometheus.io/scrape                      : "true"
    prometheus.io/port                        : "5000"
    prometheus.io/path                        : "/metrics"
  labels:
    version: $kandula_full_version
    task: Final-Project
    app: kandula
spec:
  replicas: 2
  minReadySeconds: 10
  strategy:
    type: RollingUpdate
    rollingUpdate:
        maxUnavailable: 1
        maxSurge: 1
  selector:
    matchLabels:
      app: kandula
  template:
    metadata:
      labels:
        version: $kandula_full_version
        app: kandula
      annotations:
        kubernetes.io/change-cause                : "Release Kandula:$kandula_full_version"
        consul.hashicorp.com/connect-inject       : "true"
        consul.hashicorp.com/transparent-proxy    : "false"
        consul.hashicorp.com/connect-service      : "kandula"
        consul.hashicorp.com/connect-service-port : "5000"
        consul.hashicorp.com/service-tags         : "kandula,fprj"
        consul.hashicorp.com/service-name         : "kandula-application"
        consul.hashicorp.com/service-meta-owner   : "Galit Udovik"
        consul.hashicorp.com/service-meta-purpose : "Kandula final project"
        prometheus.io/scrape                      : "true"
        prometheus.io/port                        : "5000"
        prometheus.io/path                        : "/metrics"
    spec:
      containers:
        - name: kandula
          image: $kandula_full_path_with_version
          ports:
            - containerPort: 5000
              name: http
              protocol: TCP
          env:
            - name: FLASK_ENV
              value: development
          envFrom:
            - secretRef:
                name: kandula-secrets
EOF
            cat ${WORKSPACE}/deploy-kandula.yaml
                """

                sh """
tee ${WORKSPACE}/pod-kandula.yaml > /dev/null <<'EOF'
apiVersion: v1
kind: Pod
metadata:
  namespace: kandula
  labels:
    version: $kandula_full_version
    task: Final-Project
    app: kandula
  annotations:
    kubernetes.io/change-cause                : "Release Kandula:$kandula_full_version"
    consul.hashicorp.com/connect-inject       : "true"
    consul.hashicorp.com/transparent-proxy    : "false"
    consul.hashicorp.com/connect-service      : "kandula"
    consul.hashicorp.com/connect-service-port : "5000"
    consul.hashicorp.com/service-tags         : "kandula,fprj"
    consul.hashicorp.com/service-name         : "kandula-application"
    consul.hashicorp.com/service-meta-owner   : "Galit Udovik"
    consul.hashicorp.com/service-meta-purpose : "Kandula final project"
    prometheus.io/scrape                      : "true"
    prometheus.io/port                        : "5000"
    prometheus.io/path                        : "/metrics"

spec:
  containers:
    - image: ${kandula_full_path_with_version}
      name: kandula
      ports:
        - containerPort: 5000
          name: http
          protocol: TCP
      env:
        - name: FLASK_ENV
          value: development

      envFrom:
        - secretRef:
            name: kandula-secrets
EOF

            cat ${WORKSPACE}/pod-kandula.yaml
            """
            }
        }
        stage("Commit and push manifests to Git with new version number")
        {
            steps
            {
                script
                {
                    try {
                        echo "===>> Commit and push to $git_hub_repo_path_eks"
                        sshagent(['jenkins-mid-kandula-git-ssh']) {
                            sh 'git add pod-kandula.yaml'
                            sh 'git add deploy-kandula.yaml'
                            sh 'git add kandula_on_kube.yaml'
                            sh 'git commit -m "Automatic commit from Jenkins, build version ${kandula_full_path_with_version}"'
                            sh "git push origin main"
                        }
                        slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_good, message: ":blue_heart: <@U03HH1727NK>: Kandula pod manifest was commited automatically from Jenkins with new version number ${kandula_full_path_with_version} #${env.BUILD_NUMBER}"
                    } catch (Exception e) {
                        end = "failure"
                        slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_failure, message: ":bangbang: <@U03HH1727NK>: Failed commit new Kandula pod manifest to ${git_hub_repo_path_eks} for ${kandula_full_path_with_version} #${env.BUILD_NUMBER}"
                        sh 'might fail'
                    }
                }
            }
        }
    }
    post
    {
        success {
            slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_good, message: ":large_blue_circle: :white_check_mark: :100: :beer: :dancer: <@U03HH1727NK>: Finished - Succeded build Kandula docker for version ${kandula_full_path_with_version} #${env.BUILD_NUMBER}"
        }
        failure {
            slackSend channel: 'opsschool_jenkins_notification', teamDomain: 'PvtDevops', tokenCredentialId: 'PvtDevopsSlack', color: slack_color_good, message: ":red_circle: :x: :sos: :-1: <@U03HH1727NK>: Finished - Failed process to build and deply Kandula docker for version ${kandula_full_path_with_version} #${env.BUILD_NUMBER}"
        }
    }
}
