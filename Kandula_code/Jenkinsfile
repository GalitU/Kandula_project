
pipeline {
    agent
    {
        label 'Slave'
    }

    environment
    {
        user_name = 'Galit U.'
        project = 'Kandula-MidPrj'
        purpose = 'OpsSchool course'
        git_hub_repo_path = 'git@github.com:GalitU/Mid_project_kandula-app-8_pvt.git'
        kandula_mid_docker_image_name_prefix = 'kandula-mid-prj'
        docker_repo_path = 'galitu/kandula-repo'
        git_hub_credentials = 'jenkins-mid-kandula-git-ssh'
        git_hub_branch_name = 'BranchMidProject'
        dicker_repo_path = 'galitu/kandula-repo'
        git_hub_repo_path_eks = 'git@github.com:GalitU/Mid_project_Kandula_deployment.git'
        git_hub_branch_name_eks = 'main'
        slack_color_good = "#00FF00"
        slack_color_failure =  "#FF0000"
        end = "success"
    }

    stages
    {
        stage("Git Clone")
        {
            steps
            {
                script
                {
                    try {
                        slackSend color: slack_color_good, message: ":green_heart: <@U032F82RH55>. Start build of new docker version of Kandula  ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
                        echo "===>> Git Clone from $git_hub_repo_path"
                        git branch: "${git_hub_branch_name}", credentialsId: "${git_hub_credentials}", url: "${git_hub_repo_path}"
                        sh "ls -lart ./*"
                        sh "git branch -a"
                    } catch (Exception e) {
                        end = "failure"
                        slackSend color: slack_color_failure, message: ":bangbang: <@U032F82RH55>: Failed checkout ${git_hub_repo_path}"
                        sh 'might fail'
                    }
                }
            }
        }
        stage("Docker build and Tag")
        {
            steps
            {
                script
                {
                    try {
                        echo "===>> Docker image ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 will be build"
                        sh 'docker version'
                        sh 'docker build -t ${kandula_mid_docker_image_name_prefix} .'
                        sh 'docker image list'
                        sh 'docker tag ${kandula_mid_docker_image_name_prefix} ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0'
                    } catch (Exception e) {
                        end = "failure"
                        slackSend color: slack_color_failure, message: ":bangbang: <@U032F82RH55>: Build docker image failed for  ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
                        sh 'might fail'
                    }
                }
            }
        }
        stage("Push docker to private registry")
        {
            environment
            {
                docker_hub_credentials = "docker.hub.credentials"
            }
            steps
            {
                script
                {
                    try {
                        echo "===>> Push docker image ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 to $docker_repo_path"
                        withDockerRegistry([ credentialsId: "${docker_hub_credentials}", url: "" ])
                        {
                            sh 'docker push ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0'
                        }
                        slackSend color: slack_color_good, message: ":purple_heart: <@U032F82RH55>: New docker image ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER} is ready for deployment"
                    } catch (Exception e) {
                        end = "failure"
                        slackSend color: slack_color_failure, message: ":bangbang: <@U032F82RH55>: Failed upload docker image to docker hub for  ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
                        sh 'might fail'
                    }
                }
            }
        }
        stage("Clean docker image from disk of Node")
        {
            steps
            {
                script
                {
                    try {
                        echo "===>> Delete docker image ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 from Node ${env.NODE_NAME}"
                        sh 'docker images'
                        sh 'docker rmi ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0'
                        sh 'docker images'
                        sh 'docker rmi ${kandula_mid_docker_image_name_prefix}:latest'
                    } catch (Exception e) {
                        end = "failure"
                        slackSend color: slack_color_failure, message: ":bangbang: <@U032F82RH55>: Failed clean image from Jenkins agent for  ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
                        sh 'might fail'
                    }
                }
            }
        }
        stage("Get Kandula pod manifests from Git")
        {
            steps
            {
                script
                {
                    try {
                        echo "===>> Git Clone from $git_hub_repo_path"
                        git branch: "${git_hub_branch_name_eks}", credentialsId: "${git_hub_credentials}", url: "${git_hub_repo_path_eks}"
                        sh "ls -lart ./*"
                        sh "git branch -a"
                    } catch (Exception e) {
                        end = "failure"
                        slackSend color: slack_color_failure, message: ":bangbang: <@U032F82RH55>: Failed checkout Kandula pod manifest from ${git_hub_repo_path_eks} for ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
                        sh 'might fail'
                    }
                }
            }
        }
        stage("Update manifest version number")
        {
            steps
            {
                sh """
tee ${WORKSPACE}/deploy-kandula.yaml > /dev/null <<'EOF'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: deployment-kandula-app
  annotations:
    kubernetes.io/change-cause: "Release Kandula:$BUILD_NUMBER.0.0"
  labels:
    version: v$BUILD_NUMBER.0.0
    task: Mid-Project
spec:
  replicas: 2
  selector:
    matchLabels:
      app: kandula
  template:
    metadata:
      labels:
        version: v$BUILD_NUMBER.0.0
        app: kandula
    spec:
      containers:
        - name: kandula
          image: ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0
          ports:
            - containerPort: 5000
              name: http
              protocol: TCP
          env:
            - name: FLASK_ENV
              value: development
          envFrom:
            - secretRef:
                name: kandula-secrets
EOF

            cat ${WORKSPACE}/deploy-kandula.yaml

tee ${WORKSPACE}/pod-kandula.yaml > /dev/null <<'EOF'
apiVersion: v1
kind: Pod
metadata:
  name: kandula-pod
  labels:
    app: backend
spec:
  containers:
    - image: ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0
      name: kandula
      ports:
        - containerPort: 5000
          name: http
          protocol: TCP
      env:
        - name: FLASK_ENV
          value: development

      envFrom:
        - secretRef:
            name: kandula-secrets
EOF

            cat ${WORKSPACE}/pod-kandula.yaml
                """
            }
        }
        stage("Commit and push manifests to Git with new version number")
        {
            steps
            {
                script
                {
                    try {
                        echo "===>> Commit and push to $git_hub_repo_path_eks"
                        sshagent(['jenkins-mid-kandula-git-ssh']) {
                            sh 'git add pod-kandula.yaml'
                            sh 'git add deploy-kandula.yaml'
                            sh 'git commit -m "Automatic commit from Jenkins, build version ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0"'
                            sh "git push origin main"
                        }
                        slackSend color: slack_color_good, message: ":blue_heart: <@U032F82RH55>: Kandula pod manifest was commited automatically from Jenkins with new version number ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
                    } catch (Exception e) {
                        end = "failure"
                        slackSend color: slack_color_failure, message: ":bangbang: <@U032F82RH55>: Failed commit new Kandula pod manifest to ${git_hub_repo_path_eks} for ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
                        sh 'might fail'
                    }
                }
            }
        }
    }
    post {
        success {
            slackSend color: slack_color_good, message: ":large_blue_circle: :white_check_mark: :100: :beer: :dancer: <@U032F82RH55>: Finished - Succeded build Kandula docker for version ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
        }
        failure {
            slackSend color: slack_color_good, message: ":red_circle: :x: :sos: :-1: <@U032F82RH55>: Finished - Failed process to build and deply Kandula docker for version ${docker_repo_path}:${kandula_mid_docker_image_name_prefix}-v$BUILD_NUMBER.0.0 #${env.BUILD_NUMBER}"
        }
    }
}
