    pipeline {
        agent
        {
            label 'Slave'
        }

        environment
        {
            user_name = 'Galit U.'
            git_hub_credentials = 'jenkins-mid-kandula-git-ssh'
            git_hub_repo_path_eks = 'git@github.com:GalitU/Mid_project_Kandula_eks.git'
            git_hub_branch_name_eks = 'main'
        }
        stages
        {
            stage("Get last Kandula pod manifests from GIT")
            {
                steps
                {
                    slackSend color: "good", message: "${user_name}. Kandula #${env.BUILD_NUMBER} will be startd on EKS"
                    echo "===>> Git Clone from ${git_hub_branch_name_eks}"
                    git branch: "${git_hub_branch_name_eks}", credentialsId: "${git_hub_credentials}", url: "${git_hub_repo_path_eks}"
                    sh "ls -lart ./*"
                    sh "git branch -a"
                }
            }

            stage("Update Kandula secrets")
            {
        	    steps
    	        {
                    sh """
tee ${WORKSPACE}/pod_kandula_secrets.yaml > /dev/null <<'EOF'
apiVersion: v1
kind: Secret
metadata:
  name: kandula-secrets
type: Opaque
data:
  AWS_ACCESS_KEY_ID : QUtJQVhMQTY3QlRaT0NURlhJTjU=
  AWS_SECRET_ACCESS_KEY : d0lqZklteEpTVlZJWXk5NGNDR2twc3FzVHliVWlCbTlleE92Y2o3RQ==
  AWS_DEFAULT_REGION : ZXUtY2VudHJhbC0x
EOF
                """
                }
            }

            stage("Validate Kandula current status")
            {
                steps
                {
                    script
                    {
                        sh '''
                        kubectl get secrets
                        kubectl get svc
                        kubectl get pods
                        kubectl get events
                        '''
                    }
                }
            }

            stage("Start Kandula with new version")
            {
                steps
                {
                    script
                    {
                        sh '''
                        kubectl apply -f ${WORKSPACE}/pod_kandula_secrets.yaml
                        kubectl apply -f ${WORKSPACE}/pod-svc-kandula_LB.yaml
                        kubectl apply -f ${WORKSPACE}/pod-kandula.yaml
                        rm ${WORKSPACE}/pod_kandula_secrets.yaml
                        '''
                    }
                }
            }

            stage("Validate of starting of Kandula")
            {
                steps
                {
                    script
                    {
                        sh '''
                        kubectl get secrets
                        kubectl get svc
                        kubectl get pods
                        kubectl get events
                        '''
                    }
                    slackSend color: "good", message: "${user_name}. Kandula on EKS started #${env.BUILD_NUMBER}"
                }
            }
        }
    }
